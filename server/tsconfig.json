{
  // Phase 2 de la feuille de route typage — pendant serveur de web/tsconfig.json.
  // TypeScript est un ANALYSEUR (`noEmit`), le code reste 100 % JS ESM exécuté tel
  // quel par Node. Adoption INCRÉMENTALE : `checkJs: false` + opt-in `// @ts-check`
  // par fichier, donc ajouter un fichier ne peut jamais casser `npm run typecheck`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  // `../shared` : les contrats zod partagés, d'où sont inférés les types (z.infer).
  "include": ["src/**/*", "../shared/contracts.js"]
}
